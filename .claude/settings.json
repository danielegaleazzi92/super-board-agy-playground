{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-worktree-path.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-delete-outside.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protected-push.py"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.py"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-key-literals.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-key-literals.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 .claude/hooks/cleanup-wt.py --auto --fetch 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh project item-edit:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project item-add:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh api:*)",
      "Bash(gh label list:*)",
      "Bash(git worktree:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git blame:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(mkdir:*)",
      "Bash(pgrep:*)",
      "Bash(node --check:*)",
      "Bash(node:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(.claude/bin/super-board-card.sh:*)",
      "Bash(bash .claude/bin/super-board-card.sh:*)",
      "Bash(bash .claude/bin/super-board-wave-plan.sh:*)",
      "Bash(bash .claude/bin/super-board-preflight.sh:*)",
      "Bash(python3 .claude/bin/super-board-skills-ready.py:*)",
      "Bash(python3 .claude/bin/super-board-github-read.py:*)",
      "Bash(python3 .claude/bin/super-board-status.py:*)",
      "Bash(python3 .claude/bin/super-board-verification-ready.py:*)",
      "Bash(bash .claude/bin/super-board-usage.sh:*)",
      "Bash(bash .claude/bin/super-board-throttle.sh:*)",
      "Bash(bash .claude/bin/super-board-host.sh:*)",
      "Bash(bash .claude/bin/super-board-pr-body.sh:*)",
      "Bash(bash .claude/bin/super-board-codex-lane.sh:*)",
      "Bash(bash .claude/bin/super-board-codex-wave.sh:*)",
      "Bash(bash .claude/bin/super-board-agy-lane.sh:*)",
      "Bash(bash .claude/bin/super-board-agy-wave.sh:*)",
      "Bash(python3 .claude/bin/super-board-agy-permissions.py:*)",
      "Bash(bash .claude/bin/super-board-merge-gate.sh:*)",
      "Bash(gh pr merge:*)",
      "Bash(bash .claude/bin/super-board-env-check.sh:*)",
      "Bash(bash .claude/bin/super-board-gh-guard.sh:*)",
      "Bash(bash .claude/bin/super-board-stop.sh:*)"
    ]
  }
}
